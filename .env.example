# ============ 语料 / 审计 ============
CORPUS_PATH=./data/corpus.json
AUDIT_LOG_PATH=./data/audit.log

# ============ 向量 / 召回 ============
EMBEDDING_DIM=256
TOP_K=5
RERANK=false

# ============ 可选 LLM（不配置走抽取式回答） ============
LLM_ENABLED=false
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=
LLM_API_KEY=

# ============ 服务 ============
HOST=0.0.0.0
PORT=8000
